// Visitor Management System — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in `prisma7.config.ts`, not here.
}

enum Role {
  ADMIN
  GUARD
}

enum VisitorType {
  GUEST
  DELIVERY
}

/// Where an appointment sits between being booked and being used. Replaces the
/// original `used` boolean, which could only say "redeemed or not" — the two
/// dead ends a kiosk has to explain, cancelled and expired, looked identical to
/// a reference number that was never issued.
enum AppointmentStatus {
  PENDING
  CHECKED_IN
  CANCELLED
  EXPIRED
}

/// One entry in a visit's own timeline. These are append-only and describe what
/// happened, whereas `VisitStatus` describes where the visit ended up — a visit
/// that stepped out and came back is ACTIVE again, but still carries its
/// STEP_OUT and RETURN events.
enum VisitEventType {
  CHECK_IN
  STEP_OUT
  RETURN
  CHECK_OUT
}

/// Where a visit sits in its lifecycle. PENDING_RETURN is the middle state: the
/// visitor has stepped out but is expected back the same day, so the visit is
/// still open (`checkOutTime` stays null) and resumes rather than restarting.
enum VisitStatus {
  ACTIVE
  CHECKED_OUT
  PENDING_RETURN
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String
  role  Role   @default(GUARD)

  // --- Better Auth required fields ---
  //
  // No credential lives on this model. The hashed password sits on the user's
  // `Account` row with `providerId: "credential"`, which is where Better Auth
  // looks for it; a `User` with no such row simply cannot sign in with a
  // password.
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  /// Visits this user checked in on a visitor's behalf.
  checkedInVisits Visit[] @relation("VisitCheckedInBy")

  /// Visits this person closed. `onDelete: SetNull` on the other side, so
  /// removing a staff account never removes a visit.
  visitsCheckedOut Visit[] @relation("VisitCheckedOutBy")

  @@map("user")
}

model Host {
  id         String @id @default(cuid())
  name       String
  department String

  /// Whether the host still takes visitors. This is a soft delete, and it is
  /// not optional politeness: `Visitor.hostId` cascades on delete, so removing
  /// a host row would delete every visitor they ever received and, through
  /// them, every one of those visits. Deactivating takes the host out of the
  /// kiosk dropdown and leaves the history they are named in intact.
  active Boolean @default(true)

  visitors     Visitor[]
  appointments Appointment[]

  @@index([active])
  @@map("host")
}

// TODO(multi-tenancy): add organizationId FK here and scope all queries below by it once multi-tenancy is implemented.
/// The admin-configurable list behind every "purpose of visit" dropdown.
///
/// Options are retired with `isActive` rather than deleted, because historical
/// visits still point at them and a visit from last year must keep reading the
/// way it was recorded. `onDelete: Restrict` on both relations backs that up: an
/// option that anything references cannot be removed even by hand.
model PurposeOption {
  id        String   @id @default(cuid())
  label     String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  visitors     Visitor[]
  appointments Appointment[]

  /// Every dropdown asks the same question: active options, in display order.
  @@index([isActive, sortOrder])
  @@map("purpose_option")
}

model Visitor {
  id String @id @default(cuid())

  /// Name parts as typed (trimmed, whitespace collapsed, casing kept). Display
  /// through `formatFullName()`. `lastName` may be empty: single-word legacy
  /// names were backfilled that way, and a DELIVERY row keeps the courier or
  /// company name whole in `firstName`.
  firstName String
  lastName  String

  /// Nullable so a delivery — which collects no purpose from anyone — and any
  /// future edge case can stand without one. Guests always carry one.
  purposeId String?
  purpose   PurposeOption? @relation(fields: [purposeId], references: [id], onDelete: Restrict)

  /// GUEST covers walk-ins and appointments; DELIVERY is a courier drop-off.
  /// Defaults to GUEST so rows created before this column existed stay correct.
  type VisitorType @default(GUEST)

  /// Optional: a courier may have no named recipient, so a delivery can be
  /// logged without a host. Guests always carry one.
  ///
  /// `Restrict`, not `Cascade`. Under Cascade, deleting one host row deleted
  /// every visitor they ever received and — through `Visit.visitorId` — every
  /// one of those visits. Hosts are retired with `active: false` instead, and
  /// this makes the database refuse the destructive path rather than leaving it
  /// to everyone remembering not to take it.
  hostId String?
  host   Host?   @relation(fields: [hostId], references: [id], onDelete: Restrict)

  /// Where a delivery is headed when that is not one of the known hosts — the
  /// guard typed it instead of picking from the list. Mutually exclusive with
  /// `hostId` in practice, and always null for a guest.
  recipientDepartment String?

  /// Short free-text note the guard added while logging a delivery ("left at
  /// the front desk"). Null for guests, and for deliveries logged without one.
  note String?

  visits Visit[]

  createdAt DateTime @default(now())

  @@index([hostId])
  @@index([purposeId])
  @@map("visitor")
}

model Visit {
  id String @id @default(cuid())

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?

  /// Defaults to ACTIVE so rows created before this column existed — and every
  /// new visit — read the same way the old `checkOutTime IS NULL` check did.
  status VisitStatus @default(ACTIVE)

  /// When the visitor stepped out expecting to come back today. Distinct from
  /// `checkOutTime`: an exit is reversible and leaves the visit open, whereas a
  /// check-out ends it. Cleared again when they are marked as returned.
  exitTime DateTime?

  /// The guard who performed this check-in, when a guard did. Null means the
  /// visitor checked themselves in at the kiosk, so the presence of a user here
  /// is exactly what separates guard-assisted arrivals from self-service ones.
  checkedInBy     String?
  checkedInByUser User?   @relation("VisitCheckedInBy", fields: [checkedInBy], references: [id], onDelete: SetNull)

  /// Who closed this visit.
  ///
  /// Two columns rather than one on purpose. The id is the live link, and goes
  /// null if the account is ever removed; the name is a copy taken at the time
  /// and does not, so the record still reads "checked out by Rosa Santos" long
  /// after Rosa's login is gone. An audit line that evaporates when someone
  /// leaves is not an audit line.
  ///
  /// Both are null for a visit closed by the stale-visit cleanup, which is
  /// nobody — and that absence is itself the useful fact.
  checkedOutById   String?
  checkedOutBy     User?   @relation("VisitCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)
  checkedOutByName String?

  createdAt DateTime @default(now())

  events VisitEvent[]

  @@index([visitorId])
  @@index([checkedInBy])
  @@index([checkOutTime])
  @@index([status])
  @@index([checkedOutById])
  @@map("visit")
}

/// An append-only log of what happened during one visit, written in the same
/// transaction as the state change it describes.
///
/// Deliberately scoped to a single visit: there is no visitor identity across
/// visits to hang a wider history off yet, and `visitId` is the only thing this
/// needs to know. Nothing reads or writes these rows except the timeline.
model VisitEvent {
  id String @id @default(cuid())

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  eventType VisitEventType

  /// The moment the event happened, which is the state change's own timestamp
  /// rather than the moment the row was written — they are the same instant for
  /// a live action, but the backfill sets this from the visit it reconstructs.
  timestamp DateTime @default(now())

  /// Reads are always "this visit's events, oldest first", so the index covers
  /// the filter and the sort together.
  @@index([visitId, timestamp])
  @@map("visit_event")
}

/// A pre-registered visit, looked up at the kiosk by `referenceNumber`.
///
/// Deliberately minimal: the reference number is a manual-entry stand-in for a
/// QR code. Adding `qrToken String? @unique` and `expiresAt DateTime?` later is
/// additive — nothing here assumes the reference number is the only lookup key.
model Appointment {
  id String @id @default(cuid())

  /// Short and human-readable, typed on a kiosk keypad. This is the fallback
  /// path: printouts crease, cameras fail, and a visitor can read this one down
  /// a phone line.
  referenceNumber String @unique

  /// What the QR code actually encodes. A random uuid rather than the row's own
  /// id, so a photographed code leaks nothing about the table and guessing an
  /// id gets you nowhere.
  qrToken String @unique

  /// The visitor's name, split as on `Visitor`.
  firstName    String
  lastName     String
  /// Required: this is where the QR code is sent, so an appointment without one
  /// could not have been delivered.
  visitorEmail String
  visitorPhone String?

  /// Nullable for the same reason as `Visitor.purposeId`, and so an option can
  /// never be blocked from retirement by a booking that predates the list.
  purposeId String?
  purpose   PurposeOption? @relation(fields: [purposeId], references: [id], onDelete: Restrict)

  /// `Restrict` for the same reason as `Visitor.hostId`: deleting a host
  /// should never silently take pre-registrations with it.
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Restrict)

  /// When the visitor is expected.
  scheduledFor DateTime

  /// When the code stops working, set at booking to `scheduledFor` plus the
  /// grace window in `src/lib/qr.ts`. Stored rather than computed so changing
  /// that window later cannot retroactively reopen appointments that already
  /// lapsed.
  expiresAt DateTime

  status AppointmentStatus @default(PENDING)

  /// The returning-visitor profile this booking belongs to. Set only when the
  /// visitor proved they own the email (code verification), or when the
  /// booking created the profile itself. An unverified booking against an
  /// email that already has a profile stays unlinked, so nobody can attach
  /// visits to someone else's record just by typing their address.
  visitorProfileId String?
  visitorProfile   VisitorProfile? @relation(fields: [visitorProfileId], references: [id], onDelete: SetNull)

  /// When the visitor ticked the privacy consent box. Nullable only because
  /// bookings made before consent was collected have no such moment; the
  /// booking API refuses new bookings without it.
  consentAcceptedAt DateTime?

  createdAt DateTime @default(now())

  @@index([hostId])
  @@index([status])
  @@index([purposeId])
  @@index([visitorProfileId])
  @@index([scheduledFor])
  @@map("appointment")
}

/// A person who books visits, identified by email across bookings. Powers the
/// "I've been here before" prefill on the public booking page.
///
/// Deliberately minimal and separate from `Visitor`/`Visit`, which stay
/// per-visit; joining the two is a later identity refactor.
model VisitorProfile {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  /// `makeNameKey(firstName, lastName)`: lower-cased, accent-stripped,
  /// whitespace-collapsed, joined with "|". Written alongside the name, never
  /// edited on its own.
  nameKey   String
  /// Stored lower-cased and trimmed, so lookups match however it was typed.
  /// Not unique on its own: a family or a shared work inbox can hold several
  /// people, each their own profile, told apart by name.
  email     String
  phone     String?

  createdAt DateTime @default(now())

  appointments Appointment[]

  @@unique([email, nameKey])
  @@map("visitor_profile")
}

/// A one-time code emailed to prove ownership of an address before the
/// booking page reveals a stored profile.
///
/// Only an HMAC of the code is stored. A row is written for every lookup,
/// including emails with no profile (whose code is never sent), so the
/// per-email rate limit behaves identically either way and cannot be used to
/// discover who has visited.
model VisitorVerification {
  id         String    @id @default(cuid())
  /// Lower-cased and trimmed, matching `VisitorProfile.email`.
  email      String
  /// The name the code was requested for: a code proves this exact
  /// email + name pair and nothing else at that address.
  nameKey    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Rate limiting counts per email, across names.
  @@index([email, createdAt])
  /// "Latest code for this email + name".
  @@index([email, nameKey, createdAt])
  /// Pruning old rows.
  @@index([createdAt])
  @@map("visitor_verification")
}

// ---------------------------------------------------------------------------
// Better Auth models — generated by `@better-auth/cli generate`.
//
// Better Auth owns every row in these tables: it supplies the ids (which is why
// they carry no `@default`), and it is the only writer. `prisma/seed.ts` is the
// one exception — it writes the staff `Account` rows directly so the seeded
// logins exist without a sign-up endpoint being open.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
