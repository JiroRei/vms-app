// Visitor Management System — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in `prisma7.config.ts`, not here.
}

enum Role {
  ADMIN
  GUARD
}

enum VisitorType {
  GUEST
  DELIVERY
}

/// Where a visit sits in its lifecycle. PENDING_RETURN is the middle state: the
/// visitor has stepped out but is expected back the same day, so the visit is
/// still open (`checkOutTime` stays null) and resumes rather than restarting.
enum VisitStatus {
  ACTIVE
  CHECKED_OUT
  PENDING_RETURN
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String
  role  Role   @default(GUARD)

  // TEMP: dev-only plaintext password used by the throwaway login in
  // `src/lib/dev-auth.ts`. Better Auth stores its own hashed credential on
  // `Account.password`, so this column gets dropped when auth is switched on.
  password String

  // --- Better Auth required fields (scaffolded, not yet in use) ---
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Host {
  id         String @id @default(cuid())
  name       String
  department String

  visitors     Visitor[]
  appointments Appointment[]

  @@map("host")
}

model Visitor {
  id      String @id @default(cuid())
  name    String
  purpose String

  /// GUEST covers walk-ins and appointments; DELIVERY is a courier drop-off.
  /// Defaults to GUEST so rows created before this column existed stay correct.
  type VisitorType @default(GUEST)

  /// Optional: a courier may have no named recipient, so a delivery can be
  /// logged without a host. Guests always carry one.
  hostId String?
  host   Host?   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  visits Visit[]

  createdAt DateTime @default(now())

  @@index([hostId])
  @@map("visitor")
}

model Visit {
  id String @id @default(cuid())

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?

  /// Defaults to ACTIVE so rows created before this column existed — and every
  /// new visit — read the same way the old `checkOutTime IS NULL` check did.
  status VisitStatus @default(ACTIVE)

  /// When the visitor stepped out expecting to come back today. Distinct from
  /// `checkOutTime`: an exit is reversible and leaves the visit open, whereas a
  /// check-out ends it. Cleared again when they are marked as returned.
  exitTime DateTime?

  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([checkOutTime])
  @@index([status])
  @@map("visit")
}

/// A pre-registered visit, looked up at the kiosk by `referenceNumber`.
///
/// Deliberately minimal: the reference number is a manual-entry stand-in for a
/// QR code. Adding `qrToken String? @unique` and `expiresAt DateTime?` later is
/// additive — nothing here assumes the reference number is the only lookup key.
model Appointment {
  id              String @id @default(cuid())
  referenceNumber String @unique
  visitorName     String
  purpose         String

  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  /// Set once the appointment has been redeemed at the kiosk. A reference
  /// number is single-use, so this is what makes a second attempt fail.
  used Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([hostId])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// Better Auth models — generated by `@better-auth/cli generate`.
// Scaffolded ahead of time so the tables exist; nothing writes to them until
// Better Auth is switched on in `src/lib/auth.ts`.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
