{
  "name": "visitor-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "db:repair-auto-closed": "node --import tsx --conditions=react-server prisma/repair-auto-closed-visits.ts",
    "test": "node --import tsx --import ./tests/setup.ts --conditions=react-server --test --test-concurrency=1 tests/*.test.ts",
    "test:migrate": "node --import tsx tests/migrate.ts",
    "test:e2e": "node --import tsx scripts/run-e2e.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:restore": "node --import tsx scripts/restore.ts",
    "test:pass-token": "node --import tsx --test tests/pass-token.test.ts",
    "postinstall": "prisma generate --config prisma7.config.ts",
    "typecheck": "node node_modules/next/dist/bin/next typegen && node node_modules/typescript/bin/tsc --noEmit",
    "test:http:reporting": "node --import tsx --conditions=react-server tests/verify-reporting-http.ts",
    "test:http:booking-pass": "node --import tsx --conditions=react-server tests/verify-booking-pass-http.ts",
    "test:http:password-reset": "node --import tsx --conditions=react-server tests/verify-password-reset-http.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.5",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.28.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
