# Postgres connection used by Prisma (read in prisma7.config.ts and src/lib/prisma.ts)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vms?schema=public"

# --- Better Auth (required — see src/lib/auth.ts) ---
# Signs and encrypts session cookies, so it must be set before the app will
# start. Rotating it logs everyone out. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The origin the app is served from. Better Auth derives callback and cookie
# behaviour from it; without it, it falls back to the incoming request's host.
BETTER_AUTH_URL="http://localhost:3000"
