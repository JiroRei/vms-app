# Postgres connection used by Prisma (read in prisma7.config.ts and src/lib/prisma.ts)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vms?schema=public"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/vms?schema=e2e"

# --- Better Auth (required — see src/lib/auth.ts) ---
# Signs and encrypts session cookies. Rotating it logs everyone out. The value
# below is a generated sample so local development works out of the box; it is
# public, so production builds and servers refuse it (as they refuse a missing
# value or Better Auth's built-in default; see src/lib/auth-secret.ts).
# Generate your own with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="Ch9UySKhhFufjTT64Wm7fs/ZN1aV4xh4DVQ5EzZglDU="

# The origin the app is served from. Better Auth derives callback and cookie
# behaviour from it; without it, it falls back to the incoming request's host.
BETTER_AUTH_URL="http://localhost:3000"

# --- Scheduled stale-visit cleanup ---
# Bearer token for POST /api/cron/close-stale-visits, which lets a scheduler run
# the cleanup (send `Authorization: Bearer <value>`). The value below is a
# generated DEV value so the route works locally out of the box — generate your
# own for any shared or production deployment:
#   openssl rand -base64 32
# Set it to "" and the route stays closed (503) rather than opening up. The
# dashboard closes stale visits on read either way; this is only the door for
# a real scheduler.
CRON_SECRET="n7OwnoS0DBCB-Kmihauw2iZ5Tl8mVIR_T0pfbXwZcSU"

# --- Email (Resend) — appointment confirmations with the QR code attached ---
# Both are required for network sends. Missing settings queue messages for retry.
# Schedule /api/cron/process-email-outbox every minute with CRON_SECRET.
# Set EMAIL_MODE=test only for automated tests; no network calls are made.
EMAIL_MODE=""
ERROR_WEBHOOK_URL=""
RESEND_API_KEY=""
APPOINTMENT_FROM_EMAIL="VMS <visits@example.com>"

# --- Public booking: returning-visitor email verification ---
# Signs the short-lived cookie set after a visitor enters their emailed code,
# and keys the HMAC of stored codes. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_VERIFY_SECRET=""

# --- Visitor passes ---
# HMAC-SHA256 key that signs visitor pass QR codes (vp1.<passId>.<mac>, see
# docs/visitor-pass.md). Required for passes; at least 32 characters. The value
# below is a generated DEV value - generate your own for any real deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every pass in circulation at once.
PASS_SECRET="RDlmSvasSm59pAjHL1QVQ8NnOK70mz1m_KMdCU6KxTw"

# --- Per-deployment organization settings ---
# Public display values are embedded by Next.js at build time. Use a separate
# deployment and database for each organization; configure these before build.
NEXT_PUBLIC_ORGANIZATION_NAME="Visitor Management System"
NEXT_PUBLIC_SITE_TIMEZONE="Asia/Manila"
# Optional. If omitted, a readable name is derived from SITE_TIMEZONE.
NEXT_PUBLIC_SITE_TIMEZONE_LABEL=""

# --- Client addresses for rate limits ---
# How many reverse proxies (load balancer, nginx, CDN) sit in front of the app.
# 0 (default): X-Forwarded-For is ignored and the TCP connection address is
# used, which requires starting the app with `node server.mjs` (the dev and
# start scripts do). N: the client is the Nth X-Forwarded-For entry from the
# right. Set it to exactly the number of proxies you run; a higher number lets
# clients choose their own address again. See src/lib/client-ip.ts.
TRUSTED_PROXY_COUNT=0
