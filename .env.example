# Postgres connection used by Prisma (read in prisma7.config.ts and src/lib/prisma.ts)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vms?schema=public"

# --- Better Auth (scaffolded, not active yet — see src/lib/auth.ts) ---
# Generate a secret with: openssl rand -base64 32
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:3000"

# --- Email (Resend) — appointment confirmations with the QR code attached ---
# Both are required for sending. With either missing, booking still succeeds and
# the skipped send is logged — the reference number on the confirmation screen
# is what checks the visitor in either way.
RESEND_API_KEY=""
APPOINTMENT_FROM_EMAIL="VMS <visits@example.com>"

# --- Public booking: returning-visitor email verification ---
# Signs the short-lived cookie set after a visitor enters their emailed code,
# and keys the HMAC of stored codes. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_VERIFY_SECRET=""
